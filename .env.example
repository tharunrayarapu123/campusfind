# =================================================================
# CampusFind - Environment Variables Example
# Copy this file to .env and adjust values for your environment
# =================================================================

# MySQL 8 Database Configuration
DB_URL=jdbc:mysql://localhost:3306/campusfind?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=campususer
DB_PASSWORD=campuspassword

# Docker Compose MySQL Settings (Optional overrides)
MYSQL_DATABASE=campusfind
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=campususer
MYSQL_PASSWORD=campuspassword
MYSQL_PORT=3306

# Security & Authentication (JWT HMAC-SHA256 Secret, >= 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Institution College Email Domain Restriction
ALLOWED_EMAIL_DOMAIN=college.edu

# Cloudinary (Item photos upload & CDN storage)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google Gemini AI (Photo auto-tagging, matching & moderation)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Spring Mail (SMTP notification delivery)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@college.edu
MAIL_PASSWORD=your_app_password_here

# Frontend Application URL (CORS & verification links)
FRONTEND_URL=http://localhost:5173

# Server Port (default 8081 to avoid conflict with standard 8080 listeners)
PORT=8081
